{
  "name": "dudu-finds-bubu",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "test:interaction": "node tests/browser.mjs --interaction",
    "test:weather": "node tests/weather.browser.mjs",
    "test:environment": "node tests/environment.browser.mjs",
    "test:mobile": "node tests/mobile.browser.mjs",
    "test:adventure": "node tests/adventure.browser.mjs",
    "test:story": "node tests/forest-story.mjs",
    "test:deployment": "node tests/deployment.browser.mjs",
    "model:dudu": "blender --background --python scripts/build-dudu.py",
    "model:sheep": "blender --background --python scripts/build-sheep.py",
    "model:bubu": "blender --background --python scripts/build-bubu.py",
    "test:character": "node tests/blender-character.browser.mjs",
    "test:sheep": "node tests/sheep.browser.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "playwright": "1.55.1",
    "vite": "^6.1.0"
  }
}
